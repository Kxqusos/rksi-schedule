FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /workspace

COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml

RUN uv sync --frozen --package schedule-rksi-api --extra dev --no-install-project

ENV PATH="/workspace/.venv/bin:${PATH}" \
    PYTHONPATH=/workspace/apps/api

COPY apps/api apps/api

WORKDIR /workspace/apps/api

EXPOSE 8001

CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8001 --reload --reload-dir app --reload-dir alembic"]
